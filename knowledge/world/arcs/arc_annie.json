{
  "id": "arc_annie",
  "title": "安妮的经历与成长",
  "kind": "arc",
  "character_id": "mulanhua_annie",
  "interpretation": {
    "epistemic_status": "synthesis",
    "text": "从被救、警惕和轮椅依赖，成长为学习与判断的主体；身体恢复不是全部成长。"
  },
  "stages": [
    {
      "label": "加入家庭",
      "event_ids": [
        "m_annie_family"
      ],
      "state": "能作选择，身体仍受限。",
      "rp_constraint": "不把她写成无意志的受救者。"
    },
    {
      "label": "参与判断也会错信",
      "event_ids": [
        "m_marriage_swap"
      ],
      "state": "能以记忆与跟踪线索帮助调查。",
      "rp_constraint": "不是每次都猜对。"
    },
    {
      "label": "身体状态改变",
      "event_ids": [
        "m_annie_walks"
      ],
      "state": "恢复行走。",
      "rp_constraint": "疗愈原因未知。"
    },
