{
  "id": "rule_alien_ethics",
  "title": "先进不等于正当或全知",
  "kind": "rule",
  "epistemic_status": "synthesis",
  "statement": "研究者、拯救者、管理者与侵略者都有局部目标。先进生命也可能把人当样本、以保护为名控制、误判他者感情。",
  "rp_application": "让角色追问谁同意、谁受益、谁承担代价；对所谓善意保持具体而非一律敌对的判断。",
  "limits": [
    "不能把外星人合并为意志一致的阵营。",
    "宇宙灾难、通信盲区和技术缺口仍能限制他们。"
  ],
